# Copie para .env (desenvolvimento) ou cadastre no Coolify (produção).
# Todas têm valor padrão em app/core/config.py; em produção, as marcadas
# com [obrigatória] precisam ser definidas.

# --- Aplicação ---
PROJECT_NAME="Proteca API"
# [obrigatória] "production" no Coolify. Em produção a API não sobe com SECRET_KEY fraca.
ENVIRONMENT="development"

# [obrigatória] Origens do frontend, separadas por vírgula, sem barra e sem caminho no final.
# Ex.: "https://app.<ip-com-hifens>.sslip.io,http://localhost:3000"
BACKEND_CORS_ORIGINS="http://localhost:3000"

# --- JWT (Sprint 3) ---
# [obrigatória] 32+ caracteres. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-esta-chave"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# [obrigatória] Hash Argon2 da senha de professor@proteca.local. O usuário fica no banco,
# mas o hash é regravado a cada início da API: esta variável é a fonte da verdade da senha.
# Gere com: .venv/bin/python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('SUA_SENHA'))"
# No Coolify, marque como "Is Literal" (o hash tem $). Inválido = login 401.
SENHA_TESTE_HASH=""

# --- Banco de dados (Sprint 4, ADR 0003) ---
# SQLite acessado pelo SQLModel. O caminho é relativo ao diretório de trabalho:
# no container (WORKDIR /app) vira /app/data/proteca.db, onde o Coolify monta o volume
# persistente. Sem o volume, cada redeploy apaga o banco. Backup = copiar o proteca.db.
# Vazio = este mesmo padrão. O diretório é criado ao iniciar, se não existir.
DATABASE_URL="sqlite:///./data/proteca.db"
# Grava os dados de demonstração (escola, turmas, aparelhos, sessões) quando o banco está vazio.
SEED_DEMO_DATA=true

# --- Gemini (só no backend, nunca no frontend) ---
# Vazio = o Live usa o fallback local (is_mock=true).
GEMINI_API_KEY=""
# Modelo preferido e reservas, tentados nesta ordem quando um falha (503 sobrecarga, 429 cota).
# Os "lite" vêm primeiro: a cota gratuita deles é de 500 requisições/dia (os "flash", 20).
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash"
# Voz da intervenção (POST /ia/voz), também em rodízio. Sem nenhum disponível, o site usa a voz do navegador.
GEMINI_TTS_MODELS="gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Puck"
GEMINI_TIMEOUT_SECONDS=20
